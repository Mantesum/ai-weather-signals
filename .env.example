POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql+psycopg://weather_signals:CHANGE_ME@127.0.0.1:5433/weather_signals
SOURCE_CONFIG_PATH=config/sources.yaml
CITY_CONFIG_PATH=config/cities.yaml
CONFIDENCE_CONFIG_PATH=config/confidence.yaml
LLM_PROVIDER=ollama
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen3.5:9b
LLM_API_KEY=
LLM_ENABLED=true
LLM_TIMEOUT_SECONDS=45
LLM_MAX_INPUT_CHARS=2000
AUTHOR_HASH_SALT=CHANGE_ME_TO_A_RANDOM_SECRET
LOG_LEVEL=INFO
RAW_TEXT_RETENTION_DAYS=30
PUBLIC_BASE_URL=http://127.0.0.1:8000
# Optional Mastodon instances may require a token when public preview is disabled.
MASTODON_ACCESS_TOKEN=
# Optional Telegram adapter (install the telegram extra first).
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_PATH=data/private/telegram
